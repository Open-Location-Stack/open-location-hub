{
  "kind": "Dashboard",
  "metadata": {
    "name": "workers",
    "project": "location-hub"
  },
  "spec": {
    "display": {
      "name": "Worker performance",
      "description": "Inspect work item volume, service latency and outcomes. Compare HTTP and RPC request workloads."
    },
    "duration": "30m",
    "refreshInterval": "15s",
    "links": [
      {
        "name": "Pipeline overview",
        "url": "/projects/location-hub/dashboards/pipeline?start=$__from&end=$__to"
      },
      {
        "name": "Rule state machines",
        "url": "/projects/location-hub/dashboards/state-machines?start=$__from&end=$__to"
      },
      {
        "name": "Configuration and recovery",
        "url": "/projects/location-hub/dashboards/recovery?start=$__from&end=$__to"
      },
      {
        "name": "Realtime delivery",
        "url": "/projects/location-hub/dashboards/delivery?start=$__from&end=$__to"
      }
    ],
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "hub",
          "display": {
            "name": "Hub"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "defaultValue": "$__all",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "hub_id",
              "matchers": [
                "hub_runtime_alive"
              ]
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "environment",
          "display": {
            "name": "Deployment"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "defaultValue": "$__all",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "deployment_environment_name",
              "matchers": [
                "hub_runtime_alive"
              ]
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "stage",
          "display": {
            "name": "Stage"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "defaultValue": "$__all",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "stage",
              "matchers": [
                "hub_work_items_handled_total"
              ]
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "operation",
          "display": {
            "name": "Operation"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "defaultValue": "$__all",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "operation",
              "matchers": [
                "hub_work_items_handled_total{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\"${stage:regexliteral}\"}"
              ]
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "instance",
          "display": {
            "name": "Worker instance"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "defaultValue": "$__all",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "instance",
              "matchers": [
                "hub_runtime_alive"
              ]
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "mode",
          "display": {
            "name": "Traffic mode"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "defaultValue": "$__all",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "traffic_mode",
              "matchers": [
                "hub_work_items_handled_total"
              ]
            }
          }
        }
      }
    ],
    "panels": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Items handled/s",
            "description": "Completed work by operation and outcome."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (stage, operation, outcome) (rate(hub_work_items_handled_total{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\"${stage:regexliteral}\",operation=~\"${operation:regexliteral}\",instance=~\"${instance:regexliteral}\",traffic_mode=~\"${mode:regexliteral}\"}[2m]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Items handled during selected interval",
            "description": "Counter increase for each workload and outcome."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (stage, operation, outcome) (increase(hub_work_items_handled_total{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\"${stage:regexliteral}\",operation=~\"${operation:regexliteral}\",instance=~\"${instance:regexliteral}\",traffic_mode=~\"${mode:regexliteral}\"}[$__range]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Service duration",
            "description": "Per-item handler time, excluding Kafka transaction commits."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum by (le, stage, operation) (rate(hub_work_service_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\"${stage:regexliteral}\",operation=~\"${operation:regexliteral}\",instance=~\"${instance:regexliteral}\",traffic_mode=~\"${mode:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} \u00b7 {{operation}} p50"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (le, stage, operation) (rate(hub_work_service_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\"${stage:regexliteral}\",operation=~\"${operation:regexliteral}\",instance=~\"${instance:regexliteral}\",traffic_mode=~\"${mode:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} \u00b7 {{operation}} p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.99, sum by (le, stage, operation) (rate(hub_work_service_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\"${stage:regexliteral}\",operation=~\"${operation:regexliteral}\",instance=~\"${instance:regexliteral}\",traffic_mode=~\"${mode:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} \u00b7 {{operation}} p99"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Timed items/s",
            "description": "Histogram sample rate, to give latency percentiles context."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (stage, operation) (rate(hub_work_service_duration_seconds_count{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\"${stage:regexliteral}\",operation=~\"${operation:regexliteral}\",instance=~\"${instance:regexliteral}\",traffic_mode=~\"${mode:regexliteral}\"}[2m]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Queue wait",
            "description": "Wait samples are stage-scoped."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum by (le, stage) (rate(hub_processing_queue_wait_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\"${stage:regexliteral}\",instance=~\"${instance:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} p50"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (le, stage) (rate(hub_processing_queue_wait_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\"${stage:regexliteral}\",instance=~\"${instance:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.99, sum by (le, stage) (rate(hub_processing_queue_wait_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\"${stage:regexliteral}\",instance=~\"${instance:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} p99"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Commit and append duration",
            "description": "Kafka transaction or shadow append latency. Transaction series are per batch."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum by (le, stage) (rate(hub_processing_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\".*_commit|kafka_shadow_append\",instance=~\"${instance:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} p50"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (le, stage) (rate(hub_processing_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\".*_commit|kafka_shadow_append\",instance=~\"${instance:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.99, sum by (le, stage) (rate(hub_processing_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\".*_commit|kafka_shadow_append\",instance=~\"${instance:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} p99"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "REST requests/s",
            "description": "Completed HTTP requests by normalized route and status."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (method, route, status) (rate(hub_http_request_duration_seconds_count{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",route!=\"/healthz\"}[2m]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "REST requests during selected interval",
            "description": "Completed requests by normalized route and method."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (method, route) (increase(hub_http_request_duration_seconds_count{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",route!=\"/healthz\"}[$__range]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "REST request duration",
            "description": "Handler and middleware latency by normalized route."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum by (le, method, route) (rate(hub_http_request_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",route!=\"/healthz\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{method}} \u00b7 {{route}} p50"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (le, method, route) (rate(hub_http_request_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",route!=\"/healthz\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{method}} \u00b7 {{route}} p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.99, sum by (le, method, route) (rate(hub_http_request_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",route!=\"/healthz\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{method}} \u00b7 {{route}} p99"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "RPC requests/s",
            "description": "Completed RPC calls by operation and outcome."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (method, outcome) (rate(hub_rpc_requests_total{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\"}[2m]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "RPC requests during selected interval",
            "description": "Completed RPC calls in the selected dashboard range."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (method, outcome) (increase(hub_rpc_requests_total{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\"}[$__range]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-12": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "RPC request duration",
            "description": "RPC latency by operation."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum by (le, method) (rate(hub_rpc_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{method}} p50"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (le, method) (rate(hub_rpc_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{method}} p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.99, sum by (le, method) (rate(hub_rpc_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{method}} p99"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-1"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-2"
              }
            },
            {
              "x": 0,
              "y": 7,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-3"
              }
            },
            {
              "x": 12,
              "y": 7,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-4"
              }
            },
            {
              "x": 0,
              "y": 14,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-5"
              }
            },
            {
              "x": 12,
              "y": 14,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-6"
              }
            },
            {
              "x": 0,
              "y": 21,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-7"
              }
            },
            {
              "x": 12,
              "y": 21,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-8"
              }
            },
            {
              "x": 0,
              "y": 28,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-9"
              }
            },
            {
              "x": 12,
              "y": 28,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-10"
              }
            },
            {
              "x": 0,
