{
  "kind": "Dashboard",
  "metadata": {
    "name": "pipeline",
    "project": "location-hub"
  },
  "spec": {
    "display": {
      "name": "Pipeline overview",
      "description": "Compare accepted observations, Kafka commits, stage throughput and queue delays."
    },
    "duration": "30m",
    "refreshInterval": "15s",
    "links": [
      {
        "name": "Worker performance",
        "url": "/projects/location-hub/dashboards/workers?start=$__from&end=$__to"
      },
      {
        "name": "Rule state machines",
        "url": "/projects/location-hub/dashboards/state-machines?start=$__from&end=$__to"
      },
      {
        "name": "Configuration and recovery",
        "url": "/projects/location-hub/dashboards/recovery?start=$__from&end=$__to"
      },
      {
        "name": "Realtime delivery",
        "url": "/projects/location-hub/dashboards/delivery?start=$__from&end=$__to"
      }
    ],
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "hub",
          "display": {
            "name": "Hub"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "defaultValue": "$__all",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "hub_id",
              "matchers": [
                "hub_runtime_alive"
              ]
            }
          }
        }
      },
      {
        "kind": "ListVariable",
        "spec": {
          "name": "environment",
          "display": {
            "name": "Deployment"
          },
          "allowAllValue": true,
          "allowMultiple": true,
          "defaultValue": "$__all",
          "sort": "alphabetical-asc",
          "plugin": {
            "kind": "PrometheusLabelValuesVariable",
            "spec": {
              "labelName": "deployment_environment_name",
              "matchers": [
                "hub_runtime_alive"
              ]
            }
          }
        }
      }
    ],
    "panels": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Ingress observations/s",
            "description": "Compatibility ingestion outcomes by signal and transport."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (signal, transport, outcome) (rate(hub_ingest_records_total{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\"}[2m]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Committed Kafka observations/s",
            "description": "Observations committed before the Hub acknowledges acceptance."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (operation) (rate(hub_work_items_handled_total{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=\"kafka_ingress\",outcome=\"committed\"}[2m]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Committed Kafka observations",
            "description": "Committed observation count over the selected interval. Use committed records for exact reconciliation."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (operation) (increase(hub_work_items_handled_total{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=\"kafka_ingress\",outcome=\"committed\"}[$__range]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Worker items handled/s",
            "description": "Pipeline workers have different units. Compare each stage against its own input and queue wait."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (stage, outcome) (rate(hub_work_items_handled_total{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage!=\"state_machine\"}[2m]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Queue wait by stage",
            "description": "Time from enqueue or broker append until work starts."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum by (le, stage) (rate(hub_processing_queue_wait_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage!~\".*_timer\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} p50"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (le, stage) (rate(hub_processing_queue_wait_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage!~\".*_timer\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.99, sum by (le, stage) (rate(hub_processing_queue_wait_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage!~\".*_timer\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} p99"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Event latency by scope",
            "description": "Compare broker append to gateway processing and source timestamp age where available."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum by (le, event_kind, scope) (rate(hub_processing_end_to_end_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{event_kind}} · {{scope}} p50"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (le, event_kind, scope) (rate(hub_processing_end_to_end_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{event_kind}} · {{scope}} p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.99, sum by (le, event_kind, scope) (rate(hub_processing_end_to_end_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{event_kind}} · {{scope}} p99"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Queue drops/s",
            "description": "Dropped work by processing or delivery path."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "decimal"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (stage, reason) (rate(hub_runtime_drop_events_total{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\"}[2m]))",
                    "minStep": "15s"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Kafka commit p99",
            "description": "Compare the commit time of durable ingress and each Kafka worker."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "seconds"
                }
              },
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.99, sum by (le, stage) (rate(hub_processing_duration_seconds_bucket{hub_id=~\"${hub:regexliteral}\",deployment_environment_name=~\"${environment:regexliteral}\",stage=~\".*_commit\"}[2m])))",
                    "minStep": "15s",
                    "seriesNameFormat": "{{stage}} p99"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-1"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-2"
              }
            },
            {
              "x": 0,
              "y": 7,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-3"
              }
            },
            {
              "x": 12,
              "y": 7,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-4"
              }
            },
            {
              "x": 0,
              "y": 14,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-5"
              }
            },
            {
              "x": 12,
              "y": 14,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-6"
              }
            },
            {
              "x": 0,
              "y": 21,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-7"
              }
            },
            {
              "x": 12,
              "y": 21,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/panel-8"
              }
            }
          ]
        }
      }
    ]
  }
}
